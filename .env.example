# Local development only. Copy to .env to override the defaults.
POSTGRES_DB=chronos
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos
POSTGRES_PORT=5433

DATABASE_URL=postgresql://chronos:chronos@localhost:5433/chronos

# Local admin login. Generate the hash with: node scripts/hash-password.mjs <password>
# Format: scrypt:<N>:<r>:<p>:<salt>:<hash> (base64url, no "$" so env expansion can't mangle it)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Secret for signing session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
